CONFIG_TARGET_ipq60xx=y
CONFIG_TARGET_ipq60xx_generic=y
CONFIG_TARGET_ipq60xx_generic_DEVICE_zn_m2=y

# ============================================================
# ZN-M2 精简优化版固件配置
# 目标：208MB 内存 / 6MB rootfs / kernel 4.4.60 / 无WiFi / 无USB
# 原则：只保留「路由 + 代理 + 基础管理」，砍掉一切用不到的东西
# ============================================================

# ---------- 基础构建选项 ----------
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------- 内核模块：代理必需 ----------
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-iptunnel6=y
CONFIG_PACKAGE_kmod-inet-diag=y
# OpenWrt 21.02+ 默认不编这些，Passwall/SingBox 的 socket 匹配需要
CONFIG_PACKAGE_kmod-ipt-socket=y
CONFIG_PACKAGE_iptables-mod-socket=y
# 代理 UDP/TProxy 必需
CONFIG_PACKAGE_kmod-netlink-diag=y

# ---------- 加密相关内核模块 ----------
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-crypto-deflate=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-echainiv=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-iv=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-wq=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
# zlib：压缩传输 + UPX 脱壳都可能用到
CONFIG_PACKAGE_kmod-lib-zlib-deflate=y
CONFIG_PACKAGE_kmod-lib-zlib-inflate=y

# ---------- 防火墙/网络基础 ----------
CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_libpcre=y

# ---------- 核心工具链 ----------
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zlib=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_terminfo=y

# ---------- 代理核心：Passwall ----------
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y
# Passwall 组件选择：只留 SingBox + Xray + Haproxy，其余全砍
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Server=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Trojan_Plus=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client=n
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin=n

# ---------- DNS 分流 ----------
CONFIG_PACKAGE_chinadns-ng=y

# ---------- OpenClash（你原本在用的，保留）----------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
# OpenClash 的 mihomo 内核单独放包，默认不编，让 LuCI 界面下载
# （这样内核更新不用重新刷固件）
# 如需内置内核，把下面这行改成 y：
CONFIG_PACKAGE_luci-app-openclash_INCLUDE_Mihomo_Core=n

# ---------- LuCI 基础 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-design=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 只有防火墙和这两个是日常真用的
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-app-uhttpd=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y

# ---------- 库依赖 ----------
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libev=y
CONFIG_PACKAGE_liblzo=y
CONFIG_PACKAGE_libminiupnpc=y
CONFIG_PACKAGE_libnatpmp=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libnghttp2=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libsodium=y
CONFIG_PACKAGE_libstdcpp=y
CONFIG_PACKAGE_libudns=y
CONFIG_PACKAGE_libuuid=y
CONFIG_PACKAGE_libyaml=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resolveip=y

# ---------- capsh：nohup 降权启动内核需要 ----------
CONFIG_PACKAGE_libcap-bin-capsh-shell="/bin/sh"

# ---------- 诊断工具（小体积，留着排障用）----------
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcping=y

# ============================================================
# 以下为「明确砍掉」的项（原配置里有，本版不需要）
# 说明：OpenWrt 用 defconfig 生成，未指定的包默认不编，
#       这里写成 n 是为了防止被 feeds 依赖自动带进来
# ============================================================

# --- VPN：不需要 WireGuard / OpenVPN ---
CONFIG_PACKAGE_luci-app-wireguard=n
CONFIG_PACKAGE_luci-app-openvpn=n
CONFIG_PACKAGE_luci-proto-wireguard=n
CONFIG_PACKAGE_proto-bonding=n
CONFIG_PACKAGE_kmod-wireguard=n
CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_openvpn-openssl=n
CONFIG_PACKAGE_openvpn-easy-rsa=n

# --- 内网穿透 / DDNS / 集客AC ---
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_lucky=n
CONFIG_PACKAGE_luci-app-nps=n
CONFIG_PACKAGE_luci-app-gecoosac=n
CONFIG_PACKAGE_gecoosac=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_ddns-scripts=n

# --- 杂项 luci 应用 ---
CONFIG_PACKAGE_luci-app-arpbind=n
CONFIG_PACKAGE_luci-app-autoreboot=n
CONFIG_PACKAGE_luci-app-design-config=n
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n
CONFIG_PACKAGE_luci-app-nps=n

# --- 各种 socks/dns 小工具（Passwall 自带更完整的）---
CONFIG_PACKAGE_dns2socks=n
CONFIG_PACKAGE_dns2tcp=n
CONFIG_PACKAGE_ipt2socks=n
CONFIG_PACKAGE_microsocks=n
CONFIG_PACKAGE_ssocks=n
CONFIG_PACKAGE_pdnsd-alt=n
CONFIG_PACKAGE_simple-obfs-client=n

# --- 压测/硬件类（完全用不到）---
CONFIG_PACKAGE_coremark=n
CONFIG_PACKAGE_stress-ng=n
CONFIG_PACKAGE_wol=n
CONFIG_PACKAGE_etherwake=n
CONFIG_PACKAGE_gn=n
CONFIG_PACKAGE_miniupnpd=n

# --- UPnP / 杂项 ---
CONFIG_PACKAGE_lua-neturl=n
CONFIG_PACKAGE_nss-eip-firmware=n

# --- 不再需要 curl 的冷门协议支持（省体积）---
CONFIG_LIBCURL_COOKIES=n
CONFIG_LIBCURL_FTP=n
CONFIG_LIBCURL_TFTP=n
CONFIG_LIBCURL_TLS_SRP=n
CONFIG_LIBCURL_UNIX_SOCKETS=n

# --- OpenVPN 的编译选项（已不编 openvpn，全部关掉）---
CONFIG_OPENVPN_openssl_ENABLE_DEF_AUTH=n
CONFIG_OPENVPN_openssl_ENABLE_FRAGMENT=n
CONFIG_OPENVPN_openssl_ENABLE_LZ4=n
CONFIG_OPENVPN_openssl_ENABLE_LZO=n
CONFIG_OPENVPN_openssl_ENABLE_MULTIHOME=n
CONFIG_OPENVPN_openssl_ENABLE_PF=n
CONFIG_OPENVPN_openssl_ENABLE_PORT_SHARE=n
CONFIG_OPENVPN_openssl_ENABLE_SMALL=n

# --- sodim 精简版改回完整版（代理需要完整实现）---
CONFIG_LIBSODIUM_MINIMAL=n

# --- UPnP / 杂项 ---
CONFIG_PACKAGE_luci-app-upnp=n
CONFIG_PACKAGE_luci-app-wol=n

# ============================================================
# 设备目标（必须保留）
# ============================================================
